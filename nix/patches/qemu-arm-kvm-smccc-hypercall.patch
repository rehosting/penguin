+/*
+ * Penguin hypercalls under KVM. The TCG hypercall instruction
+ * (msr S0_0_c5_c0_0, xzr; x8 = number, x0..x4 = arguments, result in x0)
+ * is UNDEFINED on hardware and traps straight to the guest kernel, which
+ * re-issues it as this SMCCC call (SMC64 fast call, OEM service range).
+ * kvm_arch_init() asks KVM to forward it to us. The guest keeps the
+ * original registers in place, except that x0 must hold the function ID:
+ *
+ *   x0 = PENGUIN_SMCCC_HYPERCALL, x6 = original x0 (argument 0),
+ *   x1..x4 = arguments 1..4, x8 = penguin hypercall number.
+ *
+ * The result is returned in x0. The guest copies x1..x5 and x8 back to the
+ * caller, so handlers that write those registers behave as under TCG. As in
+ * the TCG helper, a5 is 0 and an unhandled call returns argument 0.
+ */
+#define PENGUIN_SMCCC_HYPERCALL 0xC3001337u
+#define SMCCC_RET_NOT_SUPPORTED ((uint64_t)-1)
+
